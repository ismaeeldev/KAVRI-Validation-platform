DATABASE_URL=

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

NEXT_PUBLIC_APP_URL=http://localhost:3000

BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_NAME=
BOOTSTRAP_OWNER_TEMP_PASSWORD=

TESTER_INVITATION_TTL_HOURS=72

# Vercel Blob - required for photo upload (sample inspection photos, issue report photos).
# Provision at https://vercel.com/dashboard/stores and copy the token here (see M3 in
# sprint1_rev.md). Upload actions fail with a clear error if this is unset - they do not
# silently no-op.
BLOB_READ_WRITE_TOKEN=

NEXT_PUBLIC_KAVRI_CONTACT_EMAIL=
NEXT_PUBLIC_KAVRI_TESTING_EMAIL=

# Shared secret protecting /api/cron/publish-scheduled-updates (Step 13). Vercel Cron sends this
# automatically as `Authorization: Bearer <value>` when set as a Vercel env var - generate any
# long random string and set it in both places.
CRON_SECRET=

# Resend - required for the forgot-password email flow (Step 16, manual step M4). Provision at
# https://resend.com and copy the API key here. The reset-request action fails loudly with a
# clear error if this is unset - it does not silently report false success.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Klaviyo - required for the "Join the Build" and "Apply to Test" marketing-consent sync (Step 7,
# Workstream F, Decision 2). Provision a Private API Key at
# https://www.klaviyo.com/settings/account/api-keys with profile/subscription write scope. Both
# waitlist signup paths fail loudly (throw) if this is unset when a Klaviyo sync is attempted -
# they never claim a sync happened when it didn't. KAVRI's own database (waitlistSubscribers) is
# always the source of truth for consent/source/UTM regardless of this key's presence; a missing
# key or failed sync never blocks or rolls back the underlying signup/application record.
KLAVIYO_PRIVATE_API_KEY=
